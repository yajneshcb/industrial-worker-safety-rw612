{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "mcuxpresso-debug",
            "name": "Debug MCU (MCUXpresso LinkServer)",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "executable": {
                "elf": "${workspaceFolder}/build/debug/FRDM_RW612_WorkerSafety.elf"
            },
            "variables": {
                "mcuxStopAtSymbol": "",
                "mcuxDevice": "RW612ETA2I",
                "mcuxSerialNumber": ""
            },
            "stopAtSymbol": "",
            "probeSerialNumber": "",
            "isAttach": false,
            "skipBuildBeforeDebug": false,
            "gdbInitCommands": [
                "set remotetimeout 600",
                "set debug-file-directory",
                "set non-stop off",
                "delete"
            ],
            "gdbServerConfigs": {
                "linkserver": {
                    "device": "RW612ETA2I",
                    "gdbServerCwd": "${workspaceFolder}"
                },
                "segger": {
                  "device": "RW612"
                }
            },
            "showDevDebugOutput": "none"
        },
        {
            "name": "Debug MCU (PyOCD / CMSIS-DAP)",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "pyocd",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/debug/FRDM_RW612_WorkerSafety.elf",
            "targetId": "rw612",
            "runToEntryPoint": "main"
        },
        {
            "name": "Run Dashboard App (Python)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/dashboard/dashboard_app.py",
            "console": "integratedTerminal"
        }
    ]
}
