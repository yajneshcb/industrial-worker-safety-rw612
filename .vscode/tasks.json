{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "cmake",
      "label": "CMake: build",
      "command": "build",
      "preset": "debug",
      "targets": [
        "all"
      ],
      "dependsOn": [
        "CMake: configure"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ],
      "detail": "CMake template build task"
    },
    {
      "type": "cmake",
      "label": "CMake: configure",
      "command": "configure",
      "preset": "debug",
      "problemMatcher": [
        "$gcc"
      ],
      "detail": "CMake template configure task"
    },
    {
      "label": "CMake: Build Project (Shell)",
      "type": "shell",
      "command": "cmake --build ${workspaceFolder}/build/debug --config Debug",
      "group": {
        "kind": "build"
      },
      "problemMatcher": "$gcc"
    },
    {
      "label": "CMake: Configure (Shell)",
      "type": "shell",
      "command": "cmake --preset debug",
      "problemMatcher": []
    },
    {
      "label": "Run Laptop Dashboard",
      "type": "shell",
      "command": "python ${workspaceFolder}/dashboard/dashboard_app.py",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    }
  ]
}