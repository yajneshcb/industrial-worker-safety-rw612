{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Flash FRDM-RW612 Firmware (Direct Flash)",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File .\\flash_firmware.ps1",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Start Serial Bridge (MCU-Link -> Local/Cloud)",
      "type": "shell",
      "command": "python serial_bridge.py --baud 115200 --raw",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Start Local Dashboard Server",
      "type": "shell",
      "command": "python dashboard/dashboard_app.py",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    }
  ]
}
