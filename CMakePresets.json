{
  "version": 7,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "SdkRootDirPath": "$env{MCUX_SDK_PATH}",
        "board": "frdmrw612",
        "CONFIG_TOOLCHAIN": "armgcc",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_SYSTEM_NAME": "Generic",
        "CMAKE_SYSTEM_PROCESSOR": "cortex-m33",
        "CMAKE_TRY_COMPILE_TARGET_TYPE": "STATIC_LIBRARY",
        "CMAKE_C_COMPILER": "$env{ARMGCC_DIR}/bin/arm-none-eabi-gcc.exe",
        "CMAKE_CXX_COMPILER": "$env{ARMGCC_DIR}/bin/arm-none-eabi-g++.exe",
        "CMAKE_ASM_COMPILER": "$env{ARMGCC_DIR}/bin/arm-none-eabi-gcc.exe"
      },
      "environment": {
        "PATH": "$env{ARMGCC_DIR}/bin${pathListSep}$penv{PATH}"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "description": "Debug build (needs env vars MCUX_SDK_PATH and ARMGCC_DIR, see docs/BUILD.md)",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "description": "Optimized build (needs env vars MCUX_SDK_PATH and ARMGCC_DIR, see docs/BUILD.md)",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "displayName": "Debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "displayName": "Release",
      "configurePreset": "release"
    }
  ]
}
